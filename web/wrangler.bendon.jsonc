// Cloudflare Worker for the 愛比食堂 bendon ordering demo (issue #20). Same worker code as
// hotel-tw (wrangler.jsonc), different assets + agent. Build the UI first: scripts/build-bendon.sh
// Deploy: npx wrangler deploy -c wrangler.bendon.jsonc
// Secrets (wrangler secret put): LIVEKIT_API_KEY, LIVEKIT_API_SECRET, WEB_PASSWORD, WEB_SESSION_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bendon-demo",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat populates process.env from vars/secrets, which lib/auth.ts reads.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out-cf-bendon",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so pages can be password-gated.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "LIVEKIT_URL": "wss://gtranslate-p4i8xgo6.livekit.cloud",
    "AGENT_NAME": "bendon-zhtw",
    // Stores the page may pick (bendon_ordering/stores/*.json); the first is the default.
    "STORES": "aibi,dawudi,yujia"
  },
  // Login attempts per client IP (Cloudflare supports 10 s or 60 s windows).
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1602", "simple": { "limit": 10, "period": 60 } }],
  "routes": [{ "pattern": "bendon.wormhole.work", "custom_domain": true }],
  "observability": { "enabled": true }
}
