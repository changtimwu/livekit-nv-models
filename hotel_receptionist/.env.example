# Template consumed by `lk app env` to generate .env.local.
# No secrets here — safe to commit. Real values are written to .env.local
# (gitignored) from your linked LiveKit Cloud project credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Phase 2 (optional): run the LLM locally via MLX instead of cloud ---
# Requires: .venv/bin/python -m mlx_lm.server --model <model> --port 8080
# LLM_BACKEND=local
# LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
