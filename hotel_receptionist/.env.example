# Template consumed by `lk app env` to generate .env.local.
# No secrets here — safe to commit. Real values are written to .env.local
# (gitignored) from your linked LiveKit Cloud project credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Caller language: en (default) | zh. zh is tuned for the local backends below;
# it also picks the default Kokoro voice (zf_xiaobei) and STT language label.
# AGENT_LANGUAGE=en

# --- Phase 2 (optional): run the LLM locally via MLX instead of cloud ---
# Requires: .venv/bin/python -m mlx_lm.server --model <model> --port 8080 --prompt-cache-bytes 6GB
# LLM_BACKEND=local
# LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# TTS via mlx-audio + Kokoro: .venv/bin/python -m mlx_audio.server --port 8000
# TTS_BACKEND=local
# LOCAL_TTS_MODEL=mlx-community/Kokoro-82M-bf16
# LOCAL_TTS_VOICE=af_heart          # default from AGENT_LANGUAGE (en: af_heart, zh: zf_xiaobei)
# LOCAL_TTS_BASE_URL=http://127.0.0.1:8000/v1
# STT via mlx-audio Qwen3-ASR (in-process, no server needed):
# STT_BACKEND=local
# LOCAL_STT_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
# LOCAL_STT_LANGUAGE=en             # default from AGENT_LANGUAGE
