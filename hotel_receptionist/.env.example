# Template consumed by `lk app env` to generate .env.local.
# No secrets here — safe to commit. Real values are written to .env.local
# (gitignored) from your linked LiveKit Cloud project credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Caller language: en (default) | zh (mainland, Simplified) | zh-tw (Taiwan, Traditional).
# Picks the prompt directive plus local AND cloud STT/TTS defaults (see languages.py, issue #1).
# AGENT_LANGUAGE=en

# Worker options for running several workers on one machine (see web/README-hotel.md):
# AGENT_NAME=hotel-local        # empty = automatic dispatch (joins every new room)
# AGENT_HTTP_PORT=8082          # health port; production default 8081
# AGENT_IDLE_PROCESSES=1        # pre-warmed job processes; production default = CPU cores

# --- Phase 2 (optional): run the LLM locally via MLX instead of cloud ---
# Requires: .venv/bin/python -m mlx_lm.server --model <model> --port 8080 --prompt-cache-bytes 6GB
# LLM_BACKEND=local
# LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_TIMEOUT=180             # seconds; the first (cold-prefill) turn takes ~1 min
# TTS via mlx-audio + Kokoro: .venv/bin/python -m mlx_audio.server --port 8000
# TTS_BACKEND=local
# LOCAL_TTS_MODEL=mlx-community/Kokoro-82M-bf16
# LOCAL_TTS_VOICE=af_heart          # default from AGENT_LANGUAGE (en: af_heart, zh: zf_xiaobei)
# LOCAL_TTS_BASE_URL=http://127.0.0.1:8000/v1
# STT via mlx-audio (in-process, no server needed). Model defaults from AGENT_LANGUAGE:
# en -> Nemotron 3.5 streaming (interim transcripts, fast finals), zh -> Qwen3-ASR (batch).
# A model id containing "nemotron" selects the streaming plugin.
# STT_BACKEND=local
# LOCAL_STT_MODEL=mlx-community/nemotron-3.5-asr-streaming-0.6b
# LOCAL_STT_LANGUAGE=en             # default from AGENT_LANGUAGE
