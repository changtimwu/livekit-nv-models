# Copy to .env.local (gitignored). LIVEKIT_* come from your LiveKit Cloud project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Caller language (default zh-tw for this app). Picks the cloud STT/TTS/LLM (voiceshared.profiles).
AGENT_LANGUAGE=zh-tw

# Optional: local MLX per slot (same toggles as hotel_receptionist; see its .env.example)
# LLM_BACKEND=local
# TTS_BACKEND=local
# STT_BACKEND=local

# Worker options (several workers on one machine / named dispatch)
# AGENT_NAME=bendon-zhtw
# AGENT_HTTP_PORT=8083
# AGENT_IDLE_PROCESSES=1
